<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.controllers.MainDashboardController">
    <children>
        <Label text="Student Grade Management System">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>

        <Label text="Welcome! Choose an option below:">
            <font>
                <Font size="16.0" />
            </font>
        </Label>

        <Button onAction="#openStudentManagement" prefHeight="50.0" prefWidth="300.0" text="Manage Students">
            <font>
                <Font size="16.0" />
            </font>
        </Button>

        <Button onAction="#openGradeManagement" prefHeight="50.0" prefWidth="300.0" text="Manage Grades">
            <font>
                <Font size="16.0" />
            </font>
        </Button>
        <Button onAction="#exitApplication" prefHeight="50.0" prefWidth="300.0" text="Exit">
            <font>
                <Font size="16.0" />
            </font>
        </Button>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>